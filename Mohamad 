"backend/main.py":r'''import os
import docker
from fastapi import FastAPI, Header, HTTPException
from pydantic import BaseModel

API_TOKEN = os.getenv("API_TOKEN", "change-me")
app = FastAPI(title="Docker Server Manager API")
client = docker.from_env()

def auth(authorization: str | None):
    if authorization != f"Bearer {API_TOKEN}":
        raise HTTPException(status_code=401, detail="Unauthorized")

class ContainerRequest(BaseModel):
    name: str

@app.get("/health")
def health():
    return {"ok": True}

@app.get("/containers")
def containers(authorization: str | None = Header(default=None)):
    auth(authorization)
    return [
        {"id": c.short_id, "name": c.name, "status": c.status}
        for c in client.containers.list(all=True)
    ]

@app.post("/containers/start")
def start(req: ContainerRequest, authorization: str | None = Header(default=None)):
    auth(authorization)
    try:
        c = client.containers.get(req.name)
        c.start()
        c.reload()
        return {"ok": True, "name": c.name, "status": c.status}
    except docker.errors.NotFound:
        raise HTTPException(status_code=404, detail="Container not found")
    except docker.errors.APIError as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/containers/stop")
def stop(req: ContainerRequest, authorization: str | None = Header(default=None)):
    auth(authorization)
    try:
        c = client.containers.get(req.name)
        c.stop()
        c.reload()
        return {"ok": True, "name": c.name, "status": c.status}
    except docker.errors.NotFound:
        raise HTTPException(status_code=404, detail="Container not found")

@app.post("/containers/restart")
def restart(req: ContainerRequest, authorization: str | None = Header(default=None)):
    auth(authorization)
    try:
        c = client.containers.get(req.name)
        c.restart()
        c.reload()
        return {"ok": True, "name": c.name, "status": c.status}
    except docker.errors.NotFound:
        raise HTTPException(status_code=404, detail="Container not found")

@app.get("/containers/{name}/logs")
def logs(name: str, authorization: str | None = Header(default=None)):
    auth(authorization)
    try:
        c = client.containers.get(name)
        text = c.logs(tail=200).decode("utf-8", errors="replace")
        return {"name": c.name, "logs": text}
    except docker.errors.NotFound:
        raise HTTPException(status_code=404, detail="Container not found")
''',
